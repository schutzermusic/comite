# Main authenticated application. In Vercel Production use https://insightapex.co.
# For local development keep the local origin; for staging use its own HTTPS origin.
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Backwards-compatible site URL. Keep equal to NEXT_PUBLIC_APP_URL for the main app.
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# Dedicated employee time-tracking portal; this is intentionally not the main app URL.
NEXT_PUBLIC_PONTO_URL=https://ponto.insightapex.co

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Apex AI Gateway (server-only; never prefix provider credentials with NEXT_PUBLIC_).
# CONTRACT_EXTRACTION and COMMERCIAL_DOCUMENT_EXTRACTION use OpenAI;
# other production tasks use Anthropic.
# Set APEX_AI_ENABLED=false to exercise the
# deterministic-only operating mode.
APEX_AI_ENABLED=true
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
APEX_AI_OPENAI_MODEL=gpt-6-luna
APEX_AI_OPENAI_REASONING=low
APEX_AI_ANTHROPIC_MODEL=claude-sonnet-5
APEX_AI_ANTHROPIC_HIGH_RISK_MODEL=claude-sonnet-5
# Explicit escalation target only (never used automatically or as fallback):
APEX_AI_ANTHROPIC_COMPLEX_MODEL=claude-opus-5
APEX_AI_ANTHROPIC_ESCALATION_MODEL=claude-opus-5
APEX_AI_TIMEOUT_MS=60000
APEX_AI_MAX_ATTEMPTS=2
# "Apex busca fornecedores na internet" (Supply do local, tarefa SUPPLIER_WEB_DISCOVERY):
# busca na internet pelo provedor Anthropic (web_search; nunca web_fetch), até 5 buscas por pedido.
# DESLIGADA por padrão: só liga com o valor exato "true" E com APEX_AI_ENABLED diferente de false
# E com ANTHROPIC_API_KEY configurada. Envia só item, quantidade e UF (nunca projeto, cliente,
# organização, preço ou pessoa). Candidatos voltam NÃO VERIFICADOS, nada é gravado nem contatado.
# Cada pedido é cobrado pelo provedor (tokens + buscas) e auditado (supply.supplier_discovery.requested).
# Freio de custo: o mesmo material reaproveita a busca da organização por 30 min, e há teto em 24 h
# (janela móvel) contado nessa auditoria — lida com SUPABASE_SERVICE_ROLE_KEY; sem conseguir contar, não busca.
# Tetos: inteiro positivo até 10000; vazio ou inválido = padrão (20 por pessoa, 100 por organização).
APEX_AI_WEB_SEARCH_ENABLED=false
# APEX_AI_WEB_SEARCH_DAILY_USER_LIMIT=20
# APEX_AI_WEB_SEARCH_DAILY_ORG_LIMIT=100

# Server-side email delivery for the Ponto activation flow.
RESEND_API_KEY=your-resend-api-key
APP_EMAIL_FROM=INSIGHT APEX <no-reply@insightapex.co>

# Transporte do e-mail compartilhado (src/lib/notifications/email.ts): resend | capture | none.
# Ausente: resend quando RESEND_API_KEY existe, senão none (SIMULATED — nada sai).
# Valor desconhecido fecha em none.
# APEX_EMAIL_TRANSPORT=
# SOMENTE QA: coletor local de e-mail (Mailpit da pilha isolada). A captura recusa
# qualquer host que não seja desta máquina. Preenchido por scripts/qa/lib/qa-env.mjs.
# EMAIL_CAPTURE_URL=

# WhatsApp (avisos de Decisões): variável de ambiente NÃO liga o canal. Ele só sai com
# linha ENABLED em notification_channel_integrations (notification_channel_set, com
# motivo), provedor implementado e credenciais presentes. Nenhum provedor real existe
# ainda; os nomes das credenciais de cada provedor ficam documentados em
# src/lib/notifications/whatsapp/README.md quando ele for implementado.

# =============================================================================
# PORTÃO DE EMISSÃO FISCAL REAL — fecha por padrão
# =============================================================================
# Só um "sim" explícito (1/true/yes/on) libera a transmissão para o provedor
# REAL de NFS-e. Ausente, vazia ou qualquer outro valor = BLOQUEADO.
#
# Deliberadamente SEM prefixo NEXT_PUBLIC_: é um controle de servidor, e um
# interruptor de segurança que chega ao navegador é um interruptor que o
# navegador pode ler.
#
# Sob runner de teste (vitest/playwright/NODE_ENV=test) o portão permanece
# fechado MESMO com esta variável ligada — ver src/lib/fiscal/server/issuance-guard.ts.
#
# Sandbox e homologação NÃO dependem desta chave e continuam funcionando.
ALLOW_REAL_FISCAL_ISSUANCE=false
