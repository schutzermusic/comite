{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "board.insightapex.co" }],
      "destination": "https://insightapex.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.insightapex.co" }],
      "destination": "https://insightapex.co/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/ponto/cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/ponto/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/platform/jobs/drain",
      "schedule": "*/10 * * * *"
    }
  ]
}
